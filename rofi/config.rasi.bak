
@import "velvet.rasi"

configuration {
    modi: "drun";
    icon-theme: "Oranchelo";
    show-icons: true;
    terminal: "kitty";
    drun-display-format: "{icon} {name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    sidebar-mode: false;
    
    /* This overrides the default "drun" text label with a search icon */
    display-drun: "  : "; 
}

@theme "velvet.rasi"

* {
    bg-col:      rgba(0,0,0,0.7); 
    bg-selected: #5b5b7b88; 
    text-col:    #ffffffb3; 
    text-sel:    #ffffff;   
    accent-col:  #7aa2f7ff; 
    
    background-color: @bg-col;
    text-color:       @text-col;
    font: "JetBrainsMono Nerd Font 11";
}

window {
    height: 560px;
    width: 450px;
    border: 1px;
    border-color: @accent-col;
    border-radius: 0px;
}

mainbox {
    background-color: transparent;
}

inputbar {
    /* prompt holds the icon, entry holds your typing area */
    children: [prompt, entry];
    background-color: transparent;
    padding: 10px 10px 0px 10px; /* Reduced bottom padding for a tighter look */
}

prompt {
    /* Style the search icon here */
    background-color: transparent; /* Changed from solid blue to blend into the input bar */
    padding: 6px 0px 6px 10px;    /* Internal spacing */
    text-color: @accent-col;       /* Gives the search icon your clean blue accent color */
}

entry {
    padding: 6px;
    margin: 0px;
    text-color: @text-sel;
    background-color: transparent;
    /* This acts as a faint placeholder text before you start typing */
    placeholder: "Search applications...";
    placeholder-color: #ffffff44;
}

listview {
    border: 0px;
    padding: 6px 10px;
    margin: 10px 0px;
    columns: 1;
    lines: 6;
    background-color: transparent;
}

element {
    padding: 8px;
    background-color: transparent;
    text-color: @text-col;
    border-radius: 0px;
}

element-icon {
    size: 25px;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}

element selected {
    background-color: @bg-selected;
    text-color: @text-sel;
}
