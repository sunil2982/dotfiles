configuration {
    modi: "drun";
    icon-theme: "Paper";
    show-icons: true;
    terminal: "kitty";
    drun-display-format: "{icon} {name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    sidebar-mode: false;
    display-drun: "  : ";    
}



@theme "velvet.rasi"

* {
    /* Map to the new transparent variables generated by Matugen */
    bg-col:      @surface-transparent;  /* Fallback if variable is missing */
    bg-selected: @container-high-transparent; 
    text-col:    @on-surface; 
    text-sel:    @on-secondary-container;   
    accent-col:  @primary; 
    
    background-color: @bg-col;
    text-color:       @text-col;
    font: "JetBrainsMono Nerd Font 11";
}

window {
    height: 560px;
    width: 450px;
    border: 1px;
    border-color: @accent-col;
    border-radius: 0px;
    transparency: "real";
    background-color: @bg-col;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
}

inputbar {
    /* Added entry back so search text and cliphist items actually render */
    children: [ prompt, entry ];
    background-color: transparent;
    padding: 10px;
}

prompt {
    background-color: transparent;
    padding: 6px 4px 6px 4px;
    text-color: @accent-col;
}

entry {
    background-color: transparent;
    padding: 6px;
    text-color: @text-col;
    placeholder: "Search Clipboard...";
}

listview {
    border: 0px;
    padding: 1px 1px;
    margin: 5px 0px;
    columns: 1;
    lines: 8;
    background-color: transparent;
}

element {
    padding: 4px;
    background-color: transparent;
    text-color: @text-col;
    border-radius: 0px;
}

element-icon {
    size: 27px;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}

element selected {
    background-color: @bg-selected;
    text-color: @text-sel;
    border: 1px;
    border-color: #ffffff;
}