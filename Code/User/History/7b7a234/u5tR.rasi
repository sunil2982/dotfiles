/* ---- Configuration ---- */

configuration {
    modi:                               "drun,filebrowser,window";
    font:                                "Fira Code SemiBold 12";
    show-icons:                     true;
    display-drun:                   "";
    display-run:                     "";
    display-filebrowser:        "";
    display-window:             "";
	drun-display-format:      "{name}";
    hover-select:                    true;
    me-select-entry:            "MouseSecondary";
    me-accept-entry:            "MousePrimary";
    window-format:               "{w}{t}";
	font:                                   "JetBrainsMono Nerd Font 11";
    icon-theme:                     "Tela-circle-dracula";
    
}

/* ---- Load pywal colors (custom wal template) ---- */
/*@import "~/.config/rofi/themes/rofi-colors.rasi" */
@import "~/.config/rofi/rofi-vars.rasi"


/* ---- Window ---- */
window {
    width:						450px;
	height:						400px;
    x-offset:                   0px;
    y-offset:                   0px;
    spacing:                    0px;
    padding:                    0px;
    margin:                     0px; 
    cursor:                     "default";
    location:                   center;
    anchor:                     center;
    fullscreen:                 false;
    enabled:                    true;// Config //
configuration {
    modi:                        "drun,filebrowser,window,run";
    show-icons:                  true;
    display-drun:                "";
    display-run:                 "";
    display-filebrowser:         "";
    display-window:              "";
    drun-display-format:         "{name}";
    window-format:               "{w}{t}";
    hover-select:                true;
    me-select-entry:            "MouseSecondary";
    me-accept-entry:            "MousePrimary";
    font:                        "JetBrainsMono Nerd Font 11";
    icon-theme:                  "Paper";
}

// ---- Load pywal colors (custom wal template) ---- //
@import "~/.config/rofi/themes/rofi-colors.rasi"
@import "~/.config/rofi/rofi-vars.rasi"


// Main //
window {
    height:                      25em;
    width:                       17em;
    transparency:                "real";
    fullscreen:                  false;
    enabled:                     true;
    cursor:                      "default";
    spacing:                     0em;
    padding:                     0em;
    border:                      1px;
    border-color:                #69ff5e;
    background-color:          rgba(0,0,0,0.6);
    border-radius:               0;
    location: northWest;
    x-offset: 15px;
    y-offset: 15px;
}
mainbox {
    enabled:                     true;
    spacing:                     0em;
    padding:                     0em;
    orientation:                 horizontal;
    children:                    [ "listbox" ];
    background-color:          rgba(0,0,0,0.6);
    
}

// Inputs //
inputbar {
    padding:                     0.5em;
    spacing:                     0em;
    width:                       1em;
    enabled:                     true;
    children:                    [ "prompt","entry" ];
    background-color:            rgba(0,0,0,0.6);
    str:                          "";
    text-color: #ffffff;
     
}
entry {
    enabled:                     true;
    background-color:            rgba(80, 75, 75, 0.6);
    text-color: #ffffff;
}

prompt {
    enabled:                     true;
    background-color:            inherit;
    text-color:                  inherit;
}

textbox-prompt-colon {
    enabled:                     true;
    expand:                      false;
    str:                         " :: ";
    background-color:            inherit;
    text-color:                  inherit;
}

// Modes //
mode-switcher {
    width:                       9em;
    orientation:                 vertical;
    enabled:                     true;
    padding:                     3em 1.8em 3em 1.8em;
    spacing:                     1em;
    background-color:            transparent;
}
button {
    cursor:                      pointer;
    border-radius:               @radius;
    background-color:            transparent;
    text-color:                  #ffffff;
}
button selected {
    border-radius:               5em;
    background-color:            @foreground;
    text-color:                 #ffffff;
}


// Lists //
listbox {
    padding:                     0em;
    spacing:                     0em;
    orientation:                 vertical;
    children:                    [  "inputbar","dummy" , "listview" , "dummy" ];
    background-color:            transparent;
    
}
listview {
    padding:                     0.3em;
    spacing:                     0em;
    enabled:                     true;
    columns:                     1;
    lines:                       10;
    cycle:                       false;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    expand:                      false;
    fixed-height:                true;
    fixed-columns:               true;
    cursor:                      "default";
    background-color:            transparent;
    text-color:                  #ffffff;
}
dummy {
    background-color:            transparent;
}


// Elements //
element {
    orientation:                 horizontal;
    enabled:                     true;
    spacing:                     0.3em;
    padding:                     0.4em;
    cursor:                      pointer;
    background-color:            transparent;
    text-color:                  #ffffff;
    border-radius:               1em;
}
element selected.normal {
    background-color:            @foreground;
    text-color:                  #ffffff;
}
element-icon {
    size:                        1.3em;
    cursor:                      inherit;
    background-color:            transparent;
    text-color:                  #ffffff;
}
element-text {
    vertical-align:              0.5;
    horizontal-align:            0;
    cursor:                      inherit;
    background-color:            transparent;
    text-color:                  #ffffff;
}


    transparency:                "real";
}

/* ---- Mainbox ---- */
mainbox {
    enabled:                    true;
    orientation:                vertical;
	padding:					2px;
    background-color:    transparent;
    children:                   [ "imagebox" ];
    transparency:                "real";
}

/* ---- Imagebox ---- */
imagebox {
    background-color:           rgba(0,0,0,0.5);
    orientation:                horizontal;
    padding:                    6px;
    children:                   [   "listbox"];
}

/* ---- Listbox ---- */
listbox {
    spacing:                            5px;
    orientation:                        vertical;
    border-color:                   @active-background;
	background-color:		    transparent;
    children:                   [ "inputbar", "listview" ];
}


/* ---- Inputbar ---- */
inputbar {
    enabled:                    true;
    text-color:                 #ffffff;
    spacing:                    10px;
    border-radius:              @radius-second;
	background-color:		    rgba(0,0,0,0.5);
    children:                   [ "textbox-prompt-colon","entry" ];
}

textbox-prompt-colon {
    enabled:                    true;
	padding:					5px;
    expand:                     false;
    str:                        "";
    text-color:                 #ffffff;
	background-color:			transparent;
}

entry {
    enabled:                    true;
	padding:					10px;
    text-color:                 #ffffff;
    cursor:                     text;
    placeholder:                "Search..";
    placeholder-color:          transparent;
	background-color:			transparent;
}

/* ---- Mode Switcher ---- */
mode-switcher{
    orientation:				vertical;
    width:                      40px;
    enabled:                    true;
    spacing:                    20px;
    background-color:          	transparent;
    text-color:                 #ffffff;
}

button {
    padding:                   0px 12px 0px 8px;
    border-radius:             @radius-second;
    background-color:          transparent;
    text-color:                #ffffff;
    cursor:                    pointer;
    border:                    1px;
    border-color:              @active-background;
    border-radius:             20px;
}

button selected {
    background-color:          transparent;
    text-color:                #ffffff;
    border:                    1px;
    border-color:              @background;
	
}

/* ---- Listview ---- */
listview {
	enabled:					true;
            columns:					      1;
            lines:						           10;
            spacing:                           2px;
            padding:					       6px;
            dynamic:                          true;
            cycle:                               true;
            scrollbar:                         false;
            layout:                             vertical;
            reverse:                           false;
            fixed-height:                   true;
            fixed-columns:              false;
	        background-color:        transparent;

}

/* ---- Element ---- */
element {
    enabled:                    true;
    padding:                    5px;
    margin:                     2px;
    cursor:                     pointer;
    background-color:         	transparent;
    border-radius:              15px;
    border:                     0px;
}

element normal.normal {
    background-color:           transparent;
    text-color:                 #ffffff;
}

element normal.urgent {
    background-color:           transparent;
    text-color:                 #ffffff;
}

element normal.active {
    background-color:           transparent;
    text-color:                 #ffffff;
}

element selected.normal {
    background-color:           transparent;
    text-color:                 #ffffff;
}

element selected.urgent {
    background-color:           transparent;
    text-color:                 #ffffff;
}

element selected.active {
    background-color:           transparent;
    text-color:                 #ffffff;
}

element alternate.normal {
    background-color:           transparent;
    text-color:                 #ffffff;
}

element alternate.urgent {
    background-color:           transparent;
    text-color:                 #ffffff;
}

element alternate.active {
    background-color:           transparent;
    text-color:                 #ffffff;
}

element-icon {
    background-color:           transparent;
    text-color:                 #ffffff;
    size:                       30px;
    cursor:                     inherit;
}

element-text {
    background-color:           transparent;
    text-color:                 #ffffff;
    cursor:                     inherit;
    vertical-align:             0.5;
    horizontal-align:           0;
}

/*****----- Message -----*****/
message {
    background-color:           transparent;
    margin:						20px 0px 0px 0px;
    border-radius: 				12px;
}

textbox {
    padding:                    10px;
    background-color:      	transparent;
    text-color:                 #ffffff;
}

error-message {
    padding:                    15px;
    border-radius:            	12px;
    background-color:      		transparent;
    text-color:                 #ffffff;
}
