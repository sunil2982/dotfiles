// Config //
configuration {
    modi:                        "drun,filebrowser,window,run";
    show-icons:                  true;
    display-drun:                "";
    display-run:                 "";
    display-filebrowser:         "";
    display-window:              "";
    drun-display-format:         "{name}";
    window-format:               "{w}{t}";
    hover-select:                true;
    me-select-entry:            "MouseSecondary";
    me-accept-entry:            "MousePrimary";
    font:                        "JetBrainsMono Nerd Font 11";
    icon-theme:                  "Paper";
}

// ---- Load pywal colors (custom wal template) ---- //
@import "~/.config/rofi/themes/rofi-colors.rasi"
@import "~/.config/rofi/rofi-vars.rasi"


// Main //
window {
    height:                      26em;
    width:                       18em;
    transparency:                "real";
    fullscreen:                  false;
    enabled:                     true;
    cursor:                      "default";
    spacing:                     0em;
    padding:                     0em;
    border:                      1px;
    border-color:                #69ff5e;
    background-color:          rgba(0,0,0,0.6);
    border-radius:               0;
    location: northWest;
    x-offset: 15px;
    y-offset: 15px;
}
mainbox {
    enabled:                     true;
    spacing:                     0em;
    padding:                     0em;
    orientation:                 horizontal;
    children:                    [ "listbox" ];
    background-color:          rgba(0,0,0,0.6);
    
}

// Inputs //
inputbar {
    padding:                     0.5em;
    spacing:                     0em;
    width:                       1em;
    enabled:                     true;
    children:                    [ "entry" ];
    background-color:            rgba(0,0,0,0.6);
     
}
entry {
    enabled:                     true;
    background-color:            rgba(80, 75, 75, 0.6);
    str:                         "";
}


// Modes //
mode-switcher {
    width:                       9em;
    orientation:                 vertical;
    enabled:                     true;
    padding:                     3em 1.8em 3em 1.8em;
    spacing:                     1em;
    background-color:            transparent;
}
button {
    cursor:                      pointer;
    border-radius:               @radius;
    background-color:            transparent;
    text-color:                  #ffffff;
}
button selected {
    border-radius:               5em;
    background-color:            @foreground;
    text-color:                 #ffffff;
}


// Lists //
listbox {
    padding:                     0em;
    spacing:                     0em;
    orientation:                 vertical;
    children:                    [  "inputbar","dummy" , "listview" , "dummy" ];
    background-color:            transparent;
    
}
listview {
    padding:                     0.3em;
    spacing:                     0em;
    enabled:                     true;
    columns:                     1;
    lines:                       11;
    cycle:                       false;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    expand:                      false;
    fixed-height:                true;
    fixed-columns:               true;
    cursor:                      "default";
    background-color:            transparent;
    text-color:                  #ffffff;
}
dummy {
    background-color:            transparent;
}


// Elements //
element {
    orientation:                 horizontal;
    enabled:                     true;
    spacing:                     0.4em;
    padding:                     0.4em;
    cursor:                      pointer;
    background-color:            transparent;
    text-color:                  #ffffff;
    border-radius:               1em;
}
element selected.normal {
    background-color:            @foreground;
    text-color:                  #ffffff;
}
element-icon {
    size:                        1.3em;
    cursor:                      inherit;
    background-color:            transparent;
    text-color:                  #ffffff;
}
element-text {
    vertical-align:              0.5;
    horizontal-align:            0;
    cursor:                      inherit;
    background-color:            transparent;
    text-color:                  #ffffff;
}

