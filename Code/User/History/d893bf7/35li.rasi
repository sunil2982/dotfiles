configuration {
    modi: "drun";
    icon-theme: "Paper";
    show-icons: true;
    terminal: "kitty";
    drun-display-format: "{icon} {name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    sidebar-mode: false;
    
    display-drun: "  : "; 
}

@theme "velvet.rasi"

* {
    /* Map to the new transparent variables generated by Matugen */
    bg-col:      @surface-transparent; 
    bg-selected: @container-high-transparent; 
    text-col:    @on-surface; 
    text-sel:    @on-secondary-container;   
    accent-col:  @primary; 
    
    background-color: @bg-col;
    text-color:       @text-col;
    font: "JetBrainsMono Nerd Font 11";
}

window {
    height: 560px;
    width: 450px;
    border: 1px;
    border-color: @accent-col;
    border-radius: 0px;
    transparency: "real"; /* Fixed typo from transpiry */
    background-color: @bg-col;
}

mainbox {
    background-color: transparent;
}

inputbar {
    children: [prompt, entry];
    background-color: transparent;
    padding: 10px 10px 0px 10px;
}

prompt {
    background-color: transparent;
    padding: 6px 0px 6px 10px;
    text-color: @accent-col;
}

entry {
    padding: 6px;
    margin: 0px;
    text-color: @text-sel;
    background-color: transparent;
    placeholder: "Search applications...";
    placeholder-color: @outline-variant;
}

listview {
    border: 0px;
    padding: 6px 10px;
    margin: 10px 0px;
    columns: 1;
    lines: 6;
    background-color: transparent;
}

element {
    padding: 8px;
    background-color: transparent;
    text-color: @text-col;
    border-radius: 0px;
}

element-icon {
    size: 25px;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}

element selected {
    background-color: @bg-selected;
    text-color: @text-sel;
}