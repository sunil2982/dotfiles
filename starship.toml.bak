format = """
 $os \
[❯](fg:#ffa947)\
$username[❯](fg:#ffa947)\
$directory[❯](fg:#ffa947)\
$git_branch\
$git_status\
$fill\
$status\
$cmd_duration\
[❮]( fg:#ffa947)\
$time\
[ ](fg:#ffa947)
 $character""" # Added a newline and the character module here

# Disable the blank line at the start of the prompt
add_newline = false

# You can also replace your username with a neat symbol like   or disable this
# and use the os module below
[username]
show_always = true
style_user = "fg:#23fa52 "
style_root = "fg: #f74219"
format = '[$user]($style)'
disabled = false

[status]
style = ''
symbol = '[✘ ](fg:red )'
success_symbol = '[✔ ](fg:#8af75c )'
format = '[[$signal_name ](fg:red )$symbol]($style)'
map_symbol = false
disabled = false

# Configured to create the narrow prompt character with a margin space after it
[character]
success_symbol = '[❯](fg:#ffa947)'
error_symbol = '[❯](fg:red)'
disabled = false

[cmd_duration]
min_time = 1
style = ' fg:#ffa947'
format = '[[$duration](bold fg:#fa2f91 )  ]($style)'

[hostname]
ssh_only = false
style = 'fg:#b69676 '
format = '[@$hostname ]($style)'
disabled = false

# An alternative to the username module which displays a symbol that
# represents the current operating system
[os]
style = "fg:#579ff7"
disabled = false # Disabled by default

[directory]
style = "fg:#0a96d6 "
format = "[$path]($style)"
truncation_length = 9
truncation_symbol = "…/"
truncate_to_repo = false # Fixed to keep full paths visible
home_symbol = "~"        # Fixed to display absolute structural paths instead of ~
use_os_path_sep = true

# Here is how you can shorten some long paths by text replacement
# similar to mapped_locations in Oh My Posh:
[directory.substitutions]
#"~/" = "~./"
"~" = " "

[fill]
symbol = ' '
#symbol = '・'

[c]
symbol = ""
style = ""
format = '[ $symbol ]($style)'

[docker_context]
symbol = " "
style = ""
format = '[ $symbol $context ]($style) $path'

[git_branch]
style = "fg:#56b60a "
format = '[❯](fg:#707070 )[  ](fg:#56b60a )[ $branch ](bold $style)' # Updated to use your narrow chevron choice

[git_status]
style = "fg:#0a96d6 "
conflicted = "~"
up_to_date = " "
untracked = "?"
ahead = "⇡${count}"
diverged = "⇕⇡${ahead_count}⇣${behind_count}"
behind = "⇣${count}"
stashed = "*"
modified = " "
staged = '[++\($count\)](fg:#56b60a )'
renamed = " "
deleted = " "
format = '[$all_status$ahead_behind ]($style)'

[golang]
symbol = "go"
style = "fg:#FFFFFF "
format = '[ $symbol ](bold $style)'

[java]
symbol = ""
style = "fg:#0a96d6 "
format = '[ $symbol ]($style)'

[nodejs]
symbol = ""
style = "fg:#0a96d6 "
format = '[ $symbol ]($style)'

[python]
symbol = ' '
style = "fg:#0a96d6 "
format = '[ $symbol ]($style)'

[rust]
symbol = ""
style = "fg:#0a96d6 "
format = '[ $symbol ]($style)'

[time]
disabled = false
time_format = "%R" # Hour:Minute Format
style = " fg:#fa2f91"
format = '[$time ]($style)'

[os.symbols]
AlmaLinux = ""
Amazon = ""
Arch = ""
Debian = ""
Kali = ""
Linux = ""
Macos = ""
Manjaro = ""
openSUSE = ""
Pop = ""
Raspbian = ""
Redhat = ""
RedHatEnterprise = ""
Solus = "  "
SUSE = ""
Ubuntu = ""
Windows = "  "

