# vim:ft=kitty

# Generated with Matugen

# The basic colors
foreground              #e2e2e9
background              #121318
selection_foreground    #121318
selection_background    #b1c5ff
background_opacity      0.95

# Cursor colors
cursor                  #b1c5ff
cursor_text_color       #121318

# Scrollbar colors
scrollbar_handle_color  #8f9099
scrollbar_track_color   #1e1f25

# URL color when hovering with mouse
url_color               #b1c5ff

# Kitty window border colors
active_border_color     #b1c5ff
inactive_border_color   #44464f
bell_border_color       #ffb4ab

# OS Window titlebar colors
wayland_titlebar_color system
macos_titlebar_color system

# Tab bar colors
active_tab_foreground   #162e60
active_tab_background   #b1c5ff
inactive_tab_foreground #e2e2e9
inactive_tab_background #1e1f25
tab_bar_background      #0d0e13

# Colors for marks (marked text in the terminal)
mark1_foreground #121318
mark1_background #b1c5ff
mark2_foreground #121318
mark2_background #c0c6dc
mark3_foreground #121318
mark3_background #e0bbdd

# The 16 terminal colors

# black
color0 #0d0e13
color8 #44464f

# red
color1 #ffb4ab
color9 #ffb4ab

# green
color2  #b1c5ff
color10 #b1c5ff

# yellow
color3  #e0bbdd
color11 #e0bbdd

# blue
color4  #c0c6dc
color12 #c0c6dc

# magenta
color5  #485d92
color13 #485d92

# cyan
color6  #b1c5ff
color14 #b1c5ff

# white
color7  #e2e2e9
color15 #e2e2e9

# Force Kitty to make symbols scale up dynamically
symbol_map U+E000-U+EFFF,U+F000-U+FFFF,U+F0000-U+FFFFF   JetBrainsMono Nerd Font

# Adjust cell width/height slightly to give icons breathing room (Optional)
adjust_line_height  110%
adjust_column_width 100%
