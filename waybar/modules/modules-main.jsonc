{
    //_________\\ Default Modules //_________\\

    // taskbar
    "wlr/taskbar": {
		"format": "{icon}",
		"icon-size": 18,
		"icon-theme": "Tela-circle-dracula",
        "spacing": 0,
		"tooltip-format": "{title}",
		"on-click": "activate",
		"on-click-middle": "close",
		"app_ids-mapping": {
			"firefoxdeveloperedition": "firefox-developer-edition"
		}
	},

    // network
    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "format-wifi": " ",
        "format-ethernet": "󰌘",
        "tooltip-format": "Network: <span>{essid}</span>\nSignal strength: {signaldBm}dBm ({signalStrength}%)\nFrequency: {frequency}MHz\nIP: {ipaddr}/{cidr}\nGateway: {gwaddr}\nNetmask: {netmask}",
        "format-linked": "󰈀 {ifname} (No IP)",
        "format-disconnected": "󰖪 ",
        "tooltip-format-disconnected": "Disconnected",
        "interval": 2,
        "max-length": 30,
    	"format-icons": [
    		"󰤯", "󰤟", "󰤢", "󰤥", "󰤨"
    	],
        "on-click": "~/.config/rofi/rofi-wifi-menu",
        "on-click-right": "kitty -e nmtui"
    },

    // network speed
    "network#speed": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "format": "<span foreground='#99ffdd'> {bandwidthDownBytes}</span> <span foreground='#ffcc66'> {bandwidthUpBytes}</span>",
        "format-disconnected": "󰖪 ",
        "tooltip": false,
        "interval": 1,
        "max-length": 30,
    	"format-icons": [
    		"󰤯", "󰤟", "󰤢", "󰤥", "󰤨"
    	],
        "on-click-right": "kitty -e nmtui"
    },

    // idle inhibitor
    "idle_inhibitor": {
        "format": "{icon}",
        "start-activated": true,
            "format-icons": {
                "activated": "",
                "deactivated": "󰛊"
            },
        "tooltip-format-activated":"Caffeine Mode: Active \nNothing will be happen.",
        "tooltip-format-deactivated":"Caffeine Mode: Inactive\n\nIf there is no interaction with your\nsystem (mouse/keyboard), then \nScreen Lock: after 5 min \nScreen Off: after 10 min \nSleep: after 30 min"
    },

    // window
    "hyprland/window": {
        "format": "{}",
        "separate-outputs": true,
        "rewrite": {
            "(.*)${USER}@${set_sysname}:(.*)": "$1  :$2",
            "(.*) — Mozilla Firefox": "$1 󰈹",
            "(.*)Mozilla Firefox": "$1 Firefox 󰈹",
            "(.*) - Visual Studio Code": "$1 󰨞",
            "(.*)Visual Studio Code": "$1 Code 󰨞",
            "(.*) — Dolphin": "$1 󰉋",
            "(.*)Spotify.*": "$1 Spotify 󰓇",
            "(.*)Steam": "$1 Steam 󰓓",
            "(.*) - Discord": "$1  ",
            "(.*?)-\\s*YouTube(.*)": "$1󰗃", 
            "(.*?\\s)YouTube(.*)": "$1YouTube 󰗃"
        },
        "max-length": 50
    },


    // workspaces
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "on-click": "activate",
        "on-scroll-up": "hyprctl dispatch workspace e-1",
        "on-scroll-down": "hyprctl dispatch workspace e+1",
        "format": "{icon}",
        // "format-icons": {
            // "1": "",
            // "2": "",
            // "3": "",
            // "4": "",
        //     "urgent": "",
        //     "focused": "",
        //     "default": ""
        // },
        "format-icons": {
            // for arch
            // "active": "󰮯",
            // "default": ""

            // for fedora
            //  "active": "󰣛",  
            //  "default": ""

            // for opensuse
            // "active": "",
            // "default": ""
          },
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": []
        }
    },

    //------took it from JaKooLit-------//

    "hyprland/workspaces#preview": {
        "disable-scroll": true,
        "all-outputs": true,
        "warp-on-scroll": false,
        "sort-by-number": true,
        "show-special": false,
        "on-click": "activate",
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1",
        // "persistent-workspaces": {
        //     "*": 5
        //   },
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": []
        },
        "format": "{icon} {windows}",
        "format-window-separator": " ",
        "window-rewrite-default": " ",
        "window-rewrite": {		
            "title<.*amazon.*>": " ",
            "title<.*reddit.*>": " ",

            "class<firefox|org.mozilla.firefox|librewolf|floorp|mercury-browser|[Cc]achy-browser>": " ",
            "class<zen>": "󰰷 ",
            "class<waterfox|waterfox-bin>": " ",
            "class<microsoft-edge>": " ",
            "class<Chromium|Thorium|[Cc]hrome>": " ",
            "class<brave-browser>": "🦁 ",
            "class<tor browser>": " ",
            "class<firefox-developer-edition>": "󰈹 ",

            "class<kitty>": "󰄛 ",
            "class<kitty-dropterm>": " ",
            "class<com.mitchellh.ghostty>": " ",
            "class<org.wezfurlong.wezterm>": " ",

            "class<[Tt]hunderbird|[Tt]hunderbird-esr>": " ",
            "class<eu.betterbird.Betterbird>": " ",
            "title<.*gmail.*>": "󰊫 ",

            "class<[Tt]elegram-desktop|org.telegram.desktop|io.github.tdesktop_x64.TDesktop>": " ",
            "class<discord|[Ww]ebcord|Vesktop>": " ",
            "title<.*whatsapp.*>": " ",
            "title<.*zapzap.*>": " ",
            "title<.*messenger.*>": " ",
            "title<.*facebook.*>": " ",
            "title<.*instagram.*>": "󰋾 ",
            "title<.*reddit.*>": " ",
            "title<.*github.com.*>": " ",


            "title<.*ChatGPT.*>": "󰚩 ",
            "title<.*deepseek.*>": "󰚩 ",
            "title<.*qwen.*>": "󰚩 ",
            "class<subl>": "󰅳 ",
            "class<slack>": " ",

            "class<mpv>": " ",
            "class<celluloid|Zoom>": " ",
            "class<Cider>": "󰎆 ",
            "title<.*Picture-in-Picture.*>": " ",
            "title<.*youtube.*>": " ",
            "class<vlc>": "󰕼 ",
            "title<.*cmus.*>": " ",
            "class<[Ss]potify>": " ",

            "class<virt-manager>": " ",
            "class<.virt-manager-wrapped>": " ",
            "class<virtualbox manager>": "💽 ",
            "title<virtualbox>": "💽 ",
            "class<remmina>": "🖥️ ",

            "class<VSCode|code-url-handler|code-oss|codium|codium-url-handler|VSCodium|code>": "󰨞 ",
            "class<antigravity>": " ",
            "class<dev.zed.Zed>": "󰵁",
            "class<codeblocks>": "󰅩 ",
            "title<.*github.*>": " ",
            "title<*[Pp]hotopea.*>": " ",
            "class<mousepad>": " ",
            "class<libreoffice-writer>": " ",
            "class<libreoffice-startcenter>": "󰏆 ",
            "class<libreoffice-calc>": " ",
            "title<.*nvim ~.*>": " ",
            "title<.*vim.*>": " ",
            "title<.*nvim.*>": " ",
            "title<.*figma.*>": " ",
            "title<.*jira.*>": " ",
            "class<jetbrains-idea>": " ",

            "class<obs|com.obsproject.Studio>": " ",

            "class<polkit-gnome-authentication-agent-1>": "󰒃 ",
            "class<nwg-look>": " ",
            "class<[Pp]avucontrol|org.pulseaudio.pavucontrol>": "󱡫 ",
            "class<steam>": " ",
            "class<thunar|nemo|org.kde.dolphin>": "󰝰 ",	
            "class<Gparted>":"",
            "class<gimp>": " ",
            "class<emulator>": "📱 ",
            "class<android-studio>": " ",
            "class<org.pipewire.Helvum>": "󰓃",
            "class<localsend>":"",
            "class<PrusaSlicer|UltiMaker-Cura|OrcaSlicer>": "󰹛",
            "class<org.bleachbit.BleachBit>": " "
            }
        },
"bluetooth": {
    "format": "",
    "format-connected": "󰂱",
    "format-connected-battery": "󰂱 {device_battery_percentage}%",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "on-click": "blueman-manager",
    "format-icons": [
    		"󰤾", "󰥀", "󰥁", "󰥃", "󰥅","󰥈"
    	],
},


    // temperature
"temperature": {
        "thermal-zone": 1,
        "format": " {temperatureC}°C",
        "critical-threshold": 70,
        "format-critical": " {temperatureF}°F",
        "on-click": "kitty --title btop sh -c 'btop'"
    },

    
    // backlight
    "backlight": {
        "interval": 2,
        "align": 0,
        "rotate": 0,
        "format": "{icon}{percent}%",
        "format-icons": [
            " ",
            " ",
            " ",
            "󰃝 ",
            "󰃞 ",
            "󰃟 ",
            "󰃠 "
        ],
        "tooltip-format": "backlight {percent}%",
        "icon-size": 10,
       "on-click": "~/.config/hypr/scripts/brightness.sh up",
        "on-click-middle": "",
        "on-click-right": "~/.config/hypr/scripts/brightness.sh down",
        "on-update": "",
        "on-scroll-up": "~/.config/hypr/scripts/brightness.sh up",
        "on-scroll-down": "~/.config/hypr/scripts/brightness.sh down",
        "smooth-scrolling-threshold": 2
    },

    // tray
    "tray": {
        "icon-size": 18,
        "spacing": 10
    },

    // clock
    "clock": {
        "format": " {:%I:%M %p}",
        "format-alt": " {:%R 󰃭 %d·%m·%Y}",
        "on-clock-right": "exec gnome-calendar",
        "tooltip": true,
        "tooltip-format": "<span>{calendar}</span>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "on-scroll": 1,
            "on-click-right": "mode",
            "format": {
                "months": "<span color='#ffead3'><b>{}</b></span>",
                "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
                "today": "<span color='#ff6699'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-click-forward": "tz_up",
            "on-click-backward": "tz_down",
            "on-scroll-up": "shift_down",
            "on-scroll-down": "shift_up"
        }
    },

    // battery
    "battery": {
	//"interval": 5,
	"align": 0,
	"rotate": 0,
	"full-at": 100,
	"design-capacity": false,
	"states": {
		"good": 95,
		"warning": 30,
		"critical": 15
	},
	"format": "{icon} {capacity}%",
	"format-charging": " {capacity}%",
	"format-plugged": "󱘖 {capacity}%",
	"format-alt-click": "click",
	"format-full": "{icon} Full",
	"format-alt": "{icon} {time}",
	"format-icons": [
		"󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"
	    ],
	"format-time": "{H}h {M}min",
	"tooltip": true,
	"tooltip-format": "{timeTo} {power}w",
    },

    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "on-scroll-up": "~/.config/hypr/scripts/volumecontrol.sh --inc",
        "on-scroll-down": "~/.config/hypr/scripts/volumecontrol.sh --dec",
        "orientation": "vertical"
    },

    // pulseaudio
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " ",
        "tooltip": false,
        "on-click": "~/.config/hypr/scripts/volumecontrol.sh --toggle",
        "on-click-right": "pavucontrol",
        "on-scroll-up": "~/.config/hypr/scripts/volumecontrol.sh --inc",
        "on-scroll-down": "~/.config/hypr/scripts/volumecontrol.sh --dec",
        "scroll-step": 5,
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "default": ["", "", " "]
        }
    },

    // pulseautio mic
    "pulseaudio#microphone": {
        "format": "{format_source}",
        "format-source": " {volume}%",
        "format-source-muted": " ",
        "on-click": "pamixer --default-source -t",
        "on-click-right": "pavucontrol",
        "on-scroll-up": "pamixer --default-source -i 5",
        "on-scroll-down": "pamixer --default-source -d 5",
        "scroll-step": 5
    },


    "power-profiles-daemon": {
      "format": "{icon}",
      "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
      "tooltip": true,
      
      "format-icons": {
        "default": "",
        "performance": "󱓞",
        "balanced": "",
        "power-saver": ""
      }
    }

}
